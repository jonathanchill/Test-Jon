# Copy to .env and fill in. Never commit .env, and never paste keys into a chat or a document.

# PostgreSQL (the existing DigitalOcean database, in its own database or schema)
DATABASE_URL=postgres://user:password@host:5432/creator_research

# Team password for the tool. Each person signs in with their own name as the
# username, and that name is recorded on what they approve. Required in production.
APP_PASSWORD=

# live = official APIs. demo = invented channels, for trying the screens without keys.
DATA_MODE=live

# YouTube Data API v3 key (Google Cloud project with the API switched on)
YOUTUBE_API_KEY=
# Daily limits. Raise these only if Google has granted a higher quota.
YOUTUBE_SEARCH_DAILY_LIMIT=100
YOUTUBE_UNITS_DAILY_LIMIT=10000

# Claude, for search terms and fit scoring
ANTHROPIC_API_KEY=
# SCORING_MODEL=claude-opus-5-5
# SCORING_EFFORT=medium

# Version 2: Instagram Business Discovery (leave empty until the Meta app is ready)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Numbers older than this many days are refreshed the next time a brief is re-checked.
RECHECK_DAYS=30
