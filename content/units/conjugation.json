    { "id": "conj-006", "unit": "conjugation", "type": "flashcard", "fr": "Nous allons à la réunion", "en": "We're going to the meeting (more formal)", "register": "neutral", "source": "sheet", "lesson_date": null, "check": false, "tts": true },
