    { "id": "conj-001", "unit": "conjugation", "type": "errorspot", "prompt_fr": "Tu faites quoi ce soir ?", "answers": ["Tu fais quoi ce soir ?"], "fr": "Tu fais quoi ce soir ?", "en": "What are you doing tonight?", "note": "faites is the vous form; tu fais", "register": "informal", "source": "lesson", "lesson_date": null, "check": false, "tts": true },
