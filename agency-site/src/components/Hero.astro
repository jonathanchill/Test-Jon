---
/** Hero with ambient gradient blobs, grain, word-by-word title reveal and optional floating cards slot. */
interface Props { eyebrow?: string; title: string; lede?: string; dark?: boolean; cta?: { label: string; href: string }; secondary?: { label: string; href: string }; split?: boolean }
const { eyebrow, title, lede, dark = false, cta, secondary, split = false } = Astro.props;
// Split title into words, keeping inline <span class='text-signal'> markup and <br/>.
const parts = title.split(/(<[^>]+>)/g).filter(Boolean);
let i = 0; let html = '';
for (const p of parts) {
  if (p.startsWith('<')) { html += p; continue; }
  for (const word of p.split(/\s+/).filter(Boolean)) { html += `<span class="w"><span style="--i:${i++}">${word}</span></span> `; }
}
---
<section class:list={['relative overflow-hidden grain', dark ? 'bg-ink text-paper dark' : '']}>
  <div class="blobs" aria-hidden="true"><div class="blob blob-a"></div><div class="blob blob-b"></div><div class="blob blob-c"></div></div>
  <div class:list={['container-x relative py-20 lg:py-32', split && 'grid items-center gap-12 lg:grid-cols-12']}>
    <div class:list={[split && 'lg:col-span-7']}>
      {eyebrow && <p class:list={['eyebrow rise', dark && 'text-paper/50']}>{eyebrow}</p>}
      <h1 class="words mt-4 max-w-5xl text-display-xl font-bold leading-[0.95]" set:html={html} />
      {lede && <p class:list={['rise rise-3 mt-8 max-w-2xl text-xl leading-relaxed', dark ? 'text-paper/75' : 'text-ink/75']}>{lede}</p>}
      {(cta || secondary) && (
        <div class="rise rise-3 mt-10 flex flex-wrap gap-3">
          {cta && <a href={cta.href} class:list={[dark ? 'btn-light' : 'btn-primary', 'shine']}>{cta.label}</a>}
          {secondary && <a href={secondary.href} class:list={[dark ? 'btn border border-paper/30 text-paper hover:bg-paper hover:text-ink' : 'btn-outline']}>{secondary.label}</a>}
        </div>
      )}
    </div>
    {split && <div class="relative lg:col-span-5"><slot /></div>}
  </div>
  {!split && <slot />}
</section>
