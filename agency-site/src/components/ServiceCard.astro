---
import type { Service } from '@/data/services';
interface Props { service: Service }
const { service } = Astro.props;
---
<a href={`/services/${service.slug}`} class="card group flex flex-col">
  <p class="eyebrow">{service.pillar}</p>
  <h3 class="mt-3 text-xl font-semibold group-hover:text-signal">{service.title}</h3>
  <p class="mt-3 flex-1 text-ink/70">{service.summary}</p>
  <div class="mt-6 flex items-center justify-between text-sm">
    <span class="font-mono text-muted">{service.timeline}</span>
    {service.from && <span class="rounded-full bg-mint px-3 py-1 text-xs font-semibold text-ink">{service.from}</span>}
  </div>
</a>
