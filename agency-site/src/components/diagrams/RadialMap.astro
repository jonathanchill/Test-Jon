---
/**
 * Radial hub map. On scroll into view: hub pops, rings expand in sequence, connector lines draw from the hub
 * and pills spring into place. Afterwards, pulses keep travelling along the lines.
 */
interface Props { items: { label: string; icon?: string }[]; class?: string; tint?: 'mint' | 'blue' }
const { items, class: cls = '', tint = 'blue' } = Astro.props;
const positions = [
  'left:7%; top:22%', 'right:7%; top:22%', 'left:1%; top:52%', 'right:1%; top:52%', 'left:15%; top:84%', 'right:15%; top:84%',
];
const bg = tint === 'mint' ? 'radial-gradient(circle at 50% 50%, rgba(185,245,216,.9), rgba(185,245,216,.35) 35%, transparent 70%)' : 'radial-gradient(circle at 50% 50%, rgba(43,75,255,.18), rgba(43,75,255,.07) 35%, transparent 70%)';
---
<div class:list={['radial relative overflow-hidden rounded-[2rem] border border-line bg-white/70 p-6', cls]} data-animate>
  <div class="scene relative mx-auto aspect-[16/10] w-full max-w-3xl" style={`background:${bg}`}>
    {[0, 1, 2, 3].map((i) => <span class="orb absolute left-1/2 top-1/2 aspect-square rounded-full border border-ink/10" style={`width:${28 + i * 22}%; --d:${0.15 + i * 0.12}s`}></span>)}
    <span class="ripple absolute left-1/2 top-1/2 aspect-square -translate-x-1/2 -translate-y-1/2 rounded-full border border-ink/20" style="width:28%"></span>
    <svg class="links absolute inset-0 hidden h-full w-full md:block" aria-hidden="true"></svg>
    <div class="hub absolute left-1/2 top-1/2 grid h-20 w-20 place-items-center rounded-full bg-ink shadow-[0_0_0_10px_rgba(11,15,26,.08),0_0_0_22px_rgba(11,15,26,.04)]">
      <svg viewBox="0 0 64 64" class="h-10 w-10" fill="none" aria-hidden="true"><circle cx="32" cy="32" r="27" stroke="#f6f3ee" stroke-width="5"/><path d="M14 32h36" stroke="#f6f3ee" stroke-width="5" stroke-linecap="round"/><circle cx="19" cy="32" r="6.5" fill="#2b4bff"/><circle cx="45" cy="32" r="6.5" fill="#f6f3ee"/></svg>
    </div>
    <ul class="pill-set hidden md:block">
      {items.slice(0, 6).map((it, i) => (
        <li class="pill absolute" style={`${positions[i]}; --d:${0.7 + i * 0.14}s`}>
          <span class="flex items-center gap-2 whitespace-nowrap rounded-full border border-line bg-white px-3.5 py-2 text-sm font-semibold shadow-[0_8px_24px_rgba(11,15,26,.08)]"><span class="h-2 w-2 rounded-full bg-signal"></span>{it.label}</span>
        </li>
      ))}
    </ul>
  </div>
  <ul class="mt-4 flex flex-wrap justify-center gap-2 md:hidden">{items.map((it, i) => <li class="pill-m rounded-full border border-line bg-white px-3 py-1.5 text-sm font-semibold" style={`--d:${0.4 + i * 0.1}s`}>{it.label}</li>)}</ul>
</div>
<style>
  .hub { opacity: 0; transform: translate(-50%, -50%) scale(.2); transition: opacity .5s, transform .8s cubic-bezier(.2,1.2,.3,1); }
  .in .hub { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  .orb { opacity: 0; transform: translate(-50%, -50%) scale(.3); transition: opacity .6s, transform 1s cubic-bezier(.2,.8,.2,1); transition-delay: var(--d); }
  .in .orb { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  .ripple { opacity: 0; }
  /* Ripple expands over 3.4s, then rests 3s before the next (6.4s cycle). */
  .in .ripple { animation: radialRipple 6.4s cubic-bezier(.2,.6,.2,1) infinite 1.6s; }
  /* Animate size rather than scale so the 1px line never thickens. */
  @keyframes radialRipple { 0% { width: 28%; opacity: 0; } 8% { opacity: .7; } 53% { width: 96%; opacity: 0; } 100% { width: 96%; opacity: 0; } }
  .pill { opacity: 0; transform: translateY(-50%) scale(.6); transition: opacity .5s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,1.3,.3,1); transition-delay: var(--d); }
  .in .pill { opacity: 1; transform: translateY(-50%) scale(1); }
  .pill-m { opacity: 0; transform: translateY(8px); transition: opacity .5s, transform .5s; transition-delay: var(--d); }
  .in .pill-m { opacity: 1; transform: none; }
  .links :global(line) { stroke: var(--color-ink); stroke-opacity: .25; stroke-width: 1.5; stroke-dasharray: var(--len); stroke-dashoffset: var(--len); transition: stroke-dashoffset .9s cubic-bezier(.2,.7,.2,1); transition-delay: var(--d); }
  .in .links :global(line) { stroke-dashoffset: 0; }
  .links :global(.dot) { opacity: 0; transition: opacity .4s 1.6s; }
  .in .links :global(.dot) { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .hub, .orb, .pill, .pill-m, .links :global(line) { opacity: 1; transform: none; transition: none; stroke-dashoffset: 0; }
    .hub { transform: translate(-50%, -50%); } .orb { transform: translate(-50%, -50%); } .pill { transform: translateY(-50%); }
    .ripple, .in .ripple { animation: none; }
  }
</style>
<script>
  // Draw connector lines from the hub to each pill after layout, and start travelling pulses once revealed.
  const NS = 'http://www.w3.org/2000/svg';
  document.querySelectorAll<HTMLElement>('.radial').forEach((root) => {
    const scene = root.querySelector<HTMLElement>('.scene')!;
    const svg = root.querySelector<SVGSVGElement>('.links')!;
    const pills = Array.from(root.querySelectorAll<HTMLElement>('.pill'));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const build = () => {
      svg.innerHTML = '';
      const s = scene.getBoundingClientRect(); if (s.width === 0) return;
      svg.setAttribute('viewBox', `0 0 ${s.width} ${s.height}`);
      const cx = s.width / 2, cy = s.height / 2;
      pills.forEach((p, i) => {
        const r = p.getBoundingClientRect();
        const px = r.left - s.left + r.width / 2, py = r.top - s.top + r.height / 2;
        // stop the line a little short of the hub and at the pill centre (pill covers the end)
        const ang = Math.atan2(py - cy, px - cx); const sx = cx + Math.cos(ang) * 52, sy = cy + Math.sin(ang) * 52;
        const len = Math.hypot(px - sx, py - sy);
        const line = document.createElementNS(NS, 'line');
        line.setAttribute('x1', String(sx)); line.setAttribute('y1', String(sy)); line.setAttribute('x2', String(px)); line.setAttribute('y2', String(py));
        line.style.setProperty('--len', String(len)); line.style.setProperty('--d', `${0.6 + i * 0.14}s`);
        svg.appendChild(line);
        if (reduce) return;
        const dot = document.createElementNS(NS, 'circle'); dot.setAttribute('r', '3.5'); dot.setAttribute('fill', '#2b4bff'); dot.setAttribute('class', 'dot');
        const am = document.createElementNS(NS, 'animateMotion');
        am.setAttribute('dur', `${2.2 + (i % 3) * 0.5}s`); am.setAttribute('repeatCount', 'indefinite'); am.setAttribute('begin', `${1.8 + i * 0.35}s`);
        am.setAttribute('path', `M${sx} ${sy} L${px} ${py}`);
        dot.appendChild(am); svg.appendChild(dot);
      });
    };
    build();
    addEventListener('resize', build);
  });
</script>
