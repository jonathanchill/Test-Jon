---
/** Radial hub map: central mark on soft concentric rings, labelled pills around it. */
interface Props { items: { label: string; icon?: string }[]; class?: string; tint?: 'mint' | 'blue' }
const { items, class: cls = '', tint = 'blue' } = Astro.props;
// Anchor pills to the left or right edge so long labels never clip in a narrow column.
const positions = [
  'left:7%; top:22%', 'right:7%; top:22%', 'left:1%; top:52%', 'right:1%; top:52%', 'left:15%; top:84%', 'right:15%; top:84%',
];
const bg = tint === 'mint' ? 'radial-gradient(circle at 50% 50%, rgba(185,245,216,.9), rgba(185,245,216,.35) 35%, transparent 70%)' : 'radial-gradient(circle at 50% 50%, rgba(43,75,255,.18), rgba(43,75,255,.07) 35%, transparent 70%)';
---
<div class:list={['relative overflow-hidden rounded-[2rem] border border-line bg-white/70 p-6', cls]} data-animate>
  <div class="relative mx-auto aspect-[16/10] w-full max-w-3xl" style={`background:${bg}`}>
    {[0, 1, 2, 3].map((i) => <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full border border-ink/10" style={`width:${28 + i * 22}%; aspect-ratio:1;`}></span>)}
    <div class="absolute left-1/2 top-1/2 grid h-20 w-20 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-ink shadow-[0_0_0_10px_rgba(11,15,26,.08),0_0_0_22px_rgba(11,15,26,.04)]">
      <svg viewBox="0 0 64 64" class="h-10 w-10" fill="none" aria-hidden="true"><circle cx="32" cy="32" r="27" stroke="#f6f3ee" stroke-width="5"/><path d="M14 32h36" stroke="#f6f3ee" stroke-width="5" stroke-linecap="round"/><circle cx="19" cy="32" r="6.5" fill="#2b4bff"/><circle cx="45" cy="32" r="6.5" fill="#f6f3ee"/></svg>
    </div>
    <ul class="pill-set hidden md:block">
      {items.slice(0, 6).map((it, i) => (
        <li class="pill absolute" style={`${positions[i]}; --d:${0.2 + i * 0.12}s`}>
          <span class="flex items-center gap-2 whitespace-nowrap rounded-full border border-line bg-white px-3.5 py-2 text-sm font-semibold shadow-[0_8px_24px_rgba(11,15,26,.08)]"><span class="h-2 w-2 rounded-full bg-signal"></span>{it.label}</span>
        </li>
      ))}
    </ul>
  </div>
  <ul class="mt-4 flex flex-wrap justify-center gap-2 md:hidden">{items.map((it) => <li class="rounded-full border border-line bg-white px-3 py-1.5 text-sm font-semibold">{it.label}</li>)}</ul>
</div>
<style>
  .pill { opacity: 0; transform: translateY(-30%); transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1); transition-delay: var(--d); }
  .in .pill { opacity: 1; transform: translateY(-50%); }
  @media (prefers-reduced-motion: reduce) { .pill { opacity: 1; transform: translateY(-50%); transition: none; } }
</style>
