---
/**
 * Security diagram: rippling rings and a radar sweep behind a shield whose lock snaps shut on reveal,
 * plus a pre-launch checklist that ticks through on a loop. Parent gets `.in` from the scroll observer.
 */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const checks = ['Least-privilege access', 'Encrypted in transit & at rest', 'Prompt-injection tested', 'No training on your data', 'Full audit trail'];
---
<div class:list={['sec relative grid aspect-[4/5] place-items-center overflow-hidden rounded-2xl bg-[radial-gradient(circle_at_50%_30%,rgba(43,75,255,.16),transparent_55%)] sm:aspect-[4/3] sm:bg-[radial-gradient(circle_at_70%_50%,rgba(43,75,255,.16),transparent_60%)]', cls]} aria-hidden="true">
  <div class="absolute left-1/2 top-[30%] h-[52%] w-auto aspect-square -translate-x-1/2 -translate-y-1/2 sm:left-[70%] sm:top-1/2 sm:h-[92%]">
    <span class="sweep absolute inset-0 rounded-full"></span>
    {[0, 1, 2, 3].map((i) => <span class="ripple absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full border border-signal/30" style={`width:${38 + i * 18}%; aspect-ratio:1; animation-delay:${i * 0.9}s`}></span>)}
    <svg viewBox="0 0 120 140" class="shield absolute left-1/2 top-1/2 h-[46%] w-auto -translate-x-1/2 -translate-y-1/2 drop-shadow-[0_18px_30px_rgba(29,54,201,.35)]">
      <defs><linearGradient id="shg" x1="0" x2="1" y1="0" y2="1"><stop offset="0" stop-color="#3b5bff"/><stop offset="1" stop-color="#0b0f1a"/></linearGradient></defs>
      <path d="M60 6l48 18v40c0 32-21 54-48 68C33 118 12 96 12 64V24L60 6Z" fill="url(#shg)"/>
      <path d="M60 14l40 15v35c0 27-17.5 46-40 58C37.5 110 20 91 20 64V29L60 14Z" fill="none" stroke="#fff" stroke-opacity=".25" stroke-width="1.5"/>
      <path class="shackle" d="M49 60v-8a11 11 0 0 1 22 0v8" fill="none" stroke="#f6f3ee" stroke-width="5" stroke-linecap="round"/>
      <rect x="42" y="60" width="36" height="30" rx="7" fill="#f6f3ee"/>
      <circle cx="60" cy="74" r="4" fill="#2b4bff"/><path d="M60 76v6" stroke="#2b4bff" stroke-width="3" stroke-linecap="round"/>
      <path class="tick" d="M48 118l8 8 16-18" fill="none" stroke="#b9f5d8" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" pathLength="1"/>
    </svg>
  </div>
  <div class="checks absolute inset-x-4 bottom-4 flex flex-col justify-end sm:inset-x-auto sm:bottom-4 sm:left-6 sm:top-4 sm:w-[38%] sm:max-w-[215px] sm:justify-center">
    <div class="rounded-2xl border border-line bg-white/90 p-3.5 shadow-[0_18px_40px_-20px_rgba(11,15,26,.3)] backdrop-blur sm:p-4">
      <p class="eyebrow !text-[10px]">Pre-launch checks</p>
      <ul class="mt-2.5 space-y-2">
        {checks.map((c, i) => (
          <li class="row flex items-center gap-2 text-[11px] font-medium leading-tight sm:text-xs" style={`--i:${i}`}>
            <span class="box grid h-4 w-4 shrink-0 place-items-center rounded-full border border-ink/20"><svg viewBox="0 0 12 12" class="h-2.5 w-2.5"><path d="M2.5 6.5l2.2 2.2L9.5 3.8" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="label truncate">{c}</span>
          </li>
        ))}
      </ul>
      <p class="status mt-3 inline-flex items-center gap-1.5 rounded-full bg-mint px-2.5 py-1 text-[10px] font-semibold"><span class="h-1.5 w-1.5 rounded-full bg-ink"></span>Passed · ready to ship</p>
    </div>
  </div>
  <span class="absolute right-4 top-4 flex items-center gap-2 rounded-full bg-white px-3 py-1.5 text-xs font-semibold shadow-sm"><span class="relative flex h-2 w-2"><span class="pulse-dot absolute inline-flex h-full w-full rounded-full bg-mint"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-mint"></span></span>Audit log on</span>
</div>
<style>
  /* Continuous ambience */
  .ripple { animation: ripple 3.6s cubic-bezier(.2,.6,.2,1) infinite; }
  @keyframes ripple { 0% { transform: translate(-50%,-50%) scale(.85); opacity: 0; } 20% { opacity: .9; } 100% { transform: translate(-50%,-50%) scale(1.25); opacity: 0; } }
  .sweep { background: conic-gradient(from 0deg, rgba(43,75,255,0) 0deg, rgba(43,75,255,0) 300deg, rgba(43,75,255,.22) 360deg); mask: radial-gradient(circle, black 0 66%, transparent 67%); -webkit-mask: radial-gradient(circle, black 0 66%, transparent 67%); animation: spin 6s linear infinite; }
  .shield { animation: hover 6s ease-in-out infinite; }
  @keyframes hover { 0%,100% { transform: translate(-50%,-50%) translateY(0); } 50% { transform: translate(-50%,-50%) translateY(-6px); } }

  /* One-shot on reveal: shackle drops shut, then tick draws */
  .shackle { transform: translateY(-9px); transition: transform .5s cubic-bezier(.3,1.4,.4,1) .4s; }
  :global(.in) .shackle { transform: none; }
  .tick { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset .6s ease 1.1s; }
  :global(.in) .tick { stroke-dashoffset: 0; }

  /* Checklist loops: each row ticks in turn, holds, then the list resets */
  .row .box { transition: background-color .3s, border-color .3s; }
  .row .label { transition: color .3s; color: color-mix(in srgb, var(--color-ink) 55%, transparent); }
  :global(.in) .row .box { animation: tickbox 9s infinite; animation-delay: calc(var(--i) * .7s + .8s); }
  :global(.in) .row .label { animation: ticklabel 9s infinite; animation-delay: calc(var(--i) * .7s + .8s); }
  @keyframes tickbox { 0%, 4% { background: transparent; border-color: rgba(11,15,26,.2); } 8%, 78% { background: var(--color-signal); border-color: var(--color-signal); } 84%, 100% { background: transparent; border-color: rgba(11,15,26,.2); } }
  @keyframes ticklabel { 0%, 4% { color: color-mix(in srgb, var(--color-ink) 55%, transparent); } 8%, 78% { color: var(--color-ink); } 84%, 100% { color: color-mix(in srgb, var(--color-ink) 55%, transparent); } }
  .status { opacity: 0; transform: translateY(4px); }
  :global(.in) .status { animation: statusin 9s infinite; animation-delay: .8s; }
  @keyframes statusin { 0%, 38% { opacity: 0; transform: translateY(4px); } 44%, 78% { opacity: 1; transform: none; } 84%, 100% { opacity: 0; transform: translateY(4px); } }

  @media (prefers-reduced-motion: reduce) {
    .ripple, .sweep, .shield, .row .box, .row .label, .status { animation: none !important; }
    .shackle, .tick { transition: none; transform: none; stroke-dashoffset: 0; }
    .row .box { background: var(--color-signal); border-color: var(--color-signal); }
    .row .label { color: var(--color-ink); }
    .status { opacity: 1; transform: none; }
  }
</style>
