---
import type { CollectionEntry } from 'astro:content';
import { clients } from '@/data/clients';
interface Props { entry: CollectionEntry<'work'>; large?: boolean }
const { entry, large = false } = Astro.props;
const d = entry.data;
const hue = (d.order * 47) % 360;
const logo = clients.find((c) => c.name.toLowerCase() === d.client.toLowerCase());
---
<a href={`/work/${entry.id}`} class="group block">
  <div class:list={['relative overflow-hidden rounded-3xl border border-line bg-paper-deep', large ? 'aspect-[16/10]' : 'aspect-[4/3]']} style={d.image ? undefined : `background: linear-gradient(135deg, hsl(${hue} 60% 92%), hsl(${(hue + 40) % 360} 55% 80%));`}>
    {d.image && <img src={d.image} alt={d.imageAlt ?? ''} width="1600" height="1000" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />}
    <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/10 to-transparent"></div>
    {logo && <span class="absolute left-4 top-4 inline-flex h-10 items-center rounded-full bg-white/95 px-4 shadow-sm backdrop-blur"><img src={logo.src} alt={d.client} class="h-4 w-auto max-w-[120px]" loading="lazy" /></span>}
    <div class="absolute inset-x-5 bottom-5 flex items-end justify-between gap-3 text-paper">
      <span class="rounded-full bg-paper/15 px-3 py-1 text-xs font-semibold backdrop-blur">{d.category}</span>
      <span class="font-mono text-xs text-paper/70">{d.sector}</span>
    </div>
    {d.placeholder && <span class="absolute right-4 top-4 rounded-full bg-ember px-3 py-1 text-xs font-semibold text-white">Draft</span>}
  </div>
  <p class="mt-4 eyebrow">{d.client} · {d.year}</p>
  <h3 class="mt-2 text-xl font-semibold leading-snug group-hover:text-signal">{d.title}</h3>
</a>
