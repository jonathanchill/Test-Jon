---
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'work'>; large?: boolean }
const { entry, large = false } = Astro.props;
const d = entry.data;
const hue = (d.order * 47) % 360;
---
<a href={`/work/${entry.id}`} class="group block">
  <div class:list={['relative overflow-hidden rounded-3xl border border-line', large ? 'aspect-[16/10]' : 'aspect-[4/3]']} style={`background: linear-gradient(135deg, hsl(${hue} 60% 92%), hsl(${(hue + 40) % 360} 55% 80%));`}>
    <div class="absolute inset-0 flex items-end p-6">
      <span class="rounded-full bg-ink/90 px-3 py-1 text-xs font-semibold text-paper">{d.category}</span>
    </div>
    {d.placeholder && <span class="absolute right-4 top-4 rounded-full bg-ember px-3 py-1 text-xs font-semibold text-white">Placeholder</span>}
    <div class="absolute inset-0 bg-signal/0 transition-colors duration-300 group-hover:bg-signal/10"></div>
  </div>
  <p class="mt-4 eyebrow">{d.client} · {d.sector}</p>
  <h3 class="mt-2 text-xl font-semibold leading-snug group-hover:text-signal">{d.title}</h3>
</a>
