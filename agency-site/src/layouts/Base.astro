---
import '@/styles/global.css';
import Seo from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
interface Props { title: string; description: string; image?: string; type?: 'website' | 'article'; jsonLd?: Record<string, unknown> | Record<string, unknown>[]; noindex?: boolean; breadcrumbs?: { name: string; href: string }[] }
const gtm = import.meta.env.PUBLIC_GTM_ID;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0f1a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo {...Astro.props} />
    {gtm && <script is:inline define:vars={{ gtm }}>
      window.dataLayer = window.dataLayer || [];
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s);j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtm);
    </script>}
  </head>
  <body class="min-h-dvh flex flex-col">
    <Header />
    <main id="main" class="flex-1"><slot /></main>
    <Footer />
    <script>
      // Scroll reveal
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.15 });
      document.querySelectorAll('[data-reveal], [data-animate]').forEach((el) => io.observe(el));

      // Count-up numbers: <span data-count="4000" data-suffix="+">0</span>
      const cio = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue; cio.unobserve(e.target);
          const el = e.target as HTMLElement; const end = Number(el.dataset.count); const dec = (el.dataset.count || '').split('.')[1]?.length ?? 0;
          const prefix = el.dataset.prefix ?? ''; const suffix = el.dataset.suffix ?? ''; const t0 = performance.now(); const dur = 1600;
          const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          const tick = (t: number) => { const p = reduce ? 1 : Math.min(1, (t - t0) / dur); const v = end * (1 - Math.pow(1 - p, 3));
            el.textContent = prefix + v.toLocaleString('en-GB', { minimumFractionDigits: dec, maximumFractionDigits: dec }) + suffix; if (p < 1) requestAnimationFrame(tick); };
          requestAnimationFrame(tick);
        }
      }, { threshold: 0.5 });
      document.querySelectorAll('[data-count]').forEach((el) => cio.observe(el));
    </script>
  </body>
</html>
