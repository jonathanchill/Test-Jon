---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import WorkCard from '@/components/WorkCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import { getCollection, render } from 'astro:content';
import { clients } from '@/data/clients';
export async function getStaticPaths() { const all = await getCollection('work'); return all.map((e) => ({ params: { id: e.id }, props: { entry: e } })); }
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const more = (await getCollection('work')).filter((w) => w.id !== entry.id).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const hue = (d.order * 47) % 360;
const logo = clients.find((c) => c.name.toLowerCase() === d.client.toLowerCase());
---
<Base title={d.seoTitle ?? d.title} description={d.seoDescription ?? d.summary} type="article" image={d.image} breadcrumbs={[{ name: 'Work', href: '/work' }, { name: d.client, href: `/work/${entry.id}` }]}>
  <article>
    <header class="container-x pt-16 lg:pt-24">
      <p class="eyebrow">{d.client} · {d.sector} · {d.year}</p>
      <h1 class="mt-4 max-w-4xl text-display-lg font-bold leading-[1.02]">{d.title}</h1>
      <p class="mt-6 max-w-2xl text-xl text-ink/75">{d.summary}</p>
      {d.placeholder && <p class="mt-6 inline-block rounded-full bg-ember px-4 py-1 text-sm font-semibold text-white">Draft case study. Figures are illustrative until the client has signed them off.</p>}
      <div class="relative mt-10 aspect-[21/9] w-full overflow-hidden rounded-3xl border border-line" style={d.image ? undefined : `background: linear-gradient(135deg, hsl(${hue} 60% 92%), hsl(${(hue + 40) % 360} 55% 80%));`} data-reveal>
        {d.image ? <img src={d.image} alt={d.imageAlt ?? ''} width="1600" height="1000" class="absolute inset-0 h-full w-full object-cover" /> : logo && <img src={logo.src} alt="" class="absolute left-1/2 top-1/2 max-h-20 w-auto max-w-[50%] -translate-x-1/2 -translate-y-1/2 opacity-75" />}
        {d.image && logo && <span class="absolute left-6 top-6 inline-flex h-12 items-center rounded-full bg-white/95 px-5 shadow-md backdrop-blur"><img src={logo.src} alt={d.client} class="h-5 w-auto max-w-[160px]" /></span>}
        {d.image && <span class="absolute bottom-5 right-6 rounded-full bg-ink/60 px-3 py-1 font-mono text-[11px] text-paper/80 backdrop-blur">Image: {d.client}</span>}
      </div>
    </header>
    <div class="container-x mt-12 grid gap-12 lg:grid-cols-12">
      <aside class="lg:col-span-4">
        <dl class="space-y-6">
          <div><dt class="eyebrow">Services</dt><dd class="mt-2 flex flex-wrap gap-2">{d.services.map((s) => <span class="rounded-full border border-line px-3 py-1 text-sm">{s}</span>)}</dd></div>
          {d.results.length > 0 && <div><dt class="eyebrow">Results</dt><dd class="mt-2 grid gap-4">{d.results.map((r) => <div><p class="font-display text-4xl font-bold text-signal">{r.value}</p><p class="text-sm text-muted">{r.label}</p></div>)}</dd></div>}
        </dl>
      </aside>
      <div class="prose-basic lg:col-span-8"><Content /></div>
    </div>
  </article>
  <Section eyebrow="More work" title="Keep exploring.">
    <div class="grid gap-8 md:grid-cols-3">{more.map((w) => <WorkCard entry={w} />)}</div>
  </Section>
  <CtaBand />
</Base>
