---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import ContactForm from '@/components/ContactForm.astro';
import Faq from '@/components/Faq.astro';
import { site } from '@/data/site';
---
<Base title="Contact OppositeNumber, Guildford AI Agency" description={`Talk to ${site.name} about AI and digital. Book a free consultation or send us a message.`}>
  <Section>
    <div class="grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow">Get in touch</p>
        <h1 class="mt-3 text-display-lg font-bold leading-[1.02]">Ready when <span class="text-signal">you are.</span></h1>
        <p class="mt-6 text-lg text-ink/75">Tell us what you are trying to do. We will reply within one working day with an honest view and, if it makes sense, a time to talk.</p>
        <dl class="mt-10 space-y-6">
          <div><dt class="eyebrow">Email</dt><dd class="mt-1 text-xl font-semibold"><a href={`mailto:${site.email}`} class="hover:text-signal">{site.email}</a></dd></div>
          <div><dt class="eyebrow">Phone</dt><dd class="mt-1 text-xl font-semibold"><a href={site.phoneHref} class="hover:text-signal">{site.phone}</a></dd></div>
          {site.addresses.map((a) => <div><dt class="eyebrow">{a.label}</dt><dd class="mt-1 text-ink/80">{a.lines.join(', ')} <a href={a.mapsUrl} class="underline underline-offset-4">Directions</a></dd></div>)}
        </dl>
        <div class="mt-10 grid gap-4">
          <a href={site.bookingUrl} class="card block"><p class="text-lg font-semibold">Book a 30-minute intro</p><p class="mt-1 text-ink/70">Chat with one of our AI and product leads about how we can help.</p></a>
          <a href={site.bookingUrl} class="card block"><p class="text-lg font-semibold">Book a free 45-minute AI consultation</p><p class="mt-1 text-ink/70">Bring a problem. Leave with a view on whether AI is the answer and what it would take.</p></a>
        </div>
      </div>
      <div class="lg:col-span-7"><div class="rounded-3xl border border-line bg-white/60 p-8"><h2 class="text-2xl font-bold">Send us a message</h2><p class="mb-6 mt-2 text-ink/70">We read every one. No newsletters, no sales sequences.</p><ContactForm /></div></div>
    </div>
  </Section>
  <Section eyebrow="FAQs" title="Before you ask."><Faq /></Section>
</Base>
