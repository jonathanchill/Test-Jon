---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import WorkCard from '@/components/WorkCard.astro';
import Testimonials from '@/components/Testimonials.astro';
import CtaBand from '@/components/CtaBand.astro';
import Faq from '@/components/Faq.astro';
import { site } from '@/data/site';
import { pillars, services } from '@/data/services';
import { getCollection } from 'astro:content';
import HeroCards from '@/components/HeroCards.astro';
import Pipeline from '@/components/diagrams/Pipeline.astro';
import RadialMap from '@/components/diagrams/RadialMap.astro';
import FeatureCards from '@/components/FeatureCards.astro';
import Impact from '@/components/Impact.astro';
import ClientStrip from '@/components/ClientStrip.astro';
import WorkGallery from '@/components/WorkGallery.astro';
import Showreel from '@/components/Showreel.astro';
import { sectors } from '@/data/sectors';
import Bento from '@/components/diagrams/Bento.astro';

const work = (await getCollection('work')).filter((w) => w.data.featured).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const quick = services.filter((s) => s.from);
---
<Base title="Home" description={site.description}>
  <Hero
    eyebrow="AI & digital product studio · Guildford, Surrey"
    split
    title="We are your <span class='text-signal'>Opposite Number.</span>"
    lede="Guiding you through the age of AI to a more streamlined, cost-effective and powerful business. We find where AI pays back, prove it in a fixed-price sprint, then build and run the software behind it. No hype, no 40-slide decks. Working systems, measured results."
    cta={{ label: 'Book a 30-minute call', href: '/contact' }}
    secondary={{ label: 'Take the AI readiness scorecard', href: '/ai-readiness' }}
  ><HeroCards /></Hero>

  <ClientStrip />

  <section class="container-x py-14"><Impact /></section>

  <Showreel />

  <Section eyebrow="Why us" title="Three promises most agencies will not put in writing.">
    <FeatureCards />
  </Section>

  <Section eyebrow="How it works" title="From your data to your systems, with a score at every step." lede="This is the shape of every AI system we ship. Evaluation before the model, guardrails before your users, monitoring forever." class="bg-paper-deep">
    <Pipeline />
    <div class="mt-14 grid items-center gap-12 lg:grid-cols-2">
      <div data-reveal>
        <p class="eyebrow">What it looks like in production</p>
        <h3 class="mt-3 text-display-md font-bold">Real numbers, not a demo.</h3>
        <p class="mt-4 text-lg text-ink/70">The cards on the right are the kind of dashboard every client gets: evaluation scores, hours returned, cost per task and a live audit trail. If the number does not move, we tell you.</p>
      </div>
      <Bento />
    </div>
  </Section>

  <WorkGallery />

  <Section dark eyebrow="What we do" title="New processes that cut cost. New products that drive growth.">
    <div class="grid gap-10 lg:grid-cols-2" data-reveal="stagger">
      <div class="rounded-3xl border border-paper/15 p-8">
        <p class="eyebrow text-mint">AI Services</p>
        <h3 class="mt-3 text-2xl font-bold">Put AI to work in the business you already run.</h3>
        <ul class="mt-6 space-y-4">
          {pillars.ai.map((p) => <li><span class="font-semibold">{p.name}.</span> <span class="text-paper/70">{p.blurb}</span></li>)}
        </ul>
        <a href="/ai-services" class="btn-light mt-8">Explore AI services</a>
      </div>
      <div class="rounded-3xl border border-paper/15 p-8">
        <p class="eyebrow text-mint">Digital Services</p>
        <h3 class="mt-3 text-2xl font-bold">Design and build the products your customers come back for.</h3>
        <ul class="mt-6 space-y-4">
          {pillars.digital.map((p) => <li><span class="font-semibold">{p.name}.</span> <span class="text-paper/70">{p.blurb}</span></li>)}
        </ul>
        <a href="/digital-services" class="btn-light mt-8">Explore digital services</a>
      </div>
    </div>
  </Section>

  <Section eyebrow="Plugs into what you own" title="One governed AI layer. Every system you already run." lede="We do not replace your stack. We connect it. Policies, evals and an audit log sit between your tools and any model, so you can swap vendors without rebuilding.">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <RadialMap items={[{ label: 'CRM' }, { label: 'ERP' }, { label: 'Email & docs' }, { label: 'Data warehouse' }, { label: 'Slack & Teams' }, { label: 'Customer portal' }]} />
      <ul class="space-y-5" data-reveal="stagger">
        {[
          ['Vendor-neutral', 'Anthropic, OpenAI, Google or open-weight models, chosen by evaluation score and swapped without touching your systems.'],
          ['Governed by default', 'Policy checks, PII redaction and a complete audit trail on every call. Aligned to ISO 42001.'],
          ['Measured forever', 'Evals re-run automatically when a provider updates a model, so quality never silently drops.'],
        ].map(([h, p]) => (<li class="rounded-3xl border border-line bg-white/60 p-6"><h3 class="text-xl font-semibold">{h}</h3><p class="mt-2 text-ink/70">{p}</p></li>))}
      </ul>
    </div>
  </Section>

  <Section eyebrow="Start here" title="Two fixed-price ways to begin.">
    <div class="grid gap-6 md:grid-cols-2" data-reveal="stagger">
      {quick.map((s) => (
        <a href={`/services/${s.slug}`} class="card group">
          <div class="flex items-center justify-between"><p class="eyebrow">{s.pillar}</p><span class="rounded-full bg-mint px-3 py-1 text-xs font-semibold">{s.timeline}</span></div>
          <h3 class="mt-3 text-2xl font-bold group-hover:text-signal">{s.title}</h3>
          <p class="mt-3 text-ink/70">{s.summary}</p>
          <ul class="mt-5 space-y-1 text-sm text-ink/70">{s.outcomes.map((o) => <li>— {o}</li>)}</ul>
        </a>
      ))}
    </div>
  </Section>

  <Section eyebrow="Sectors" title="Built for your industry, not a generic template." lede="The same engineering rigour, shaped around the regulation, data and customers your sector actually has." class="bg-paper-deep">
    <RadialMap tint="mint" items={sectors.slice(0, 6).map((x) => ({ label: x.name }))} />
    <a href="/sectors" class="btn-outline mt-10">All sectors</a>
  </Section>

  <Section eyebrow="Selected work" title="Proof, not promises.">
    <div class="grid gap-10 md:grid-cols-2" data-reveal="stagger">{work.map((w, i) => <WorkCard entry={w} large={i < 2} />)}</div>
    <a href="/work" class="btn-outline mt-12">See all work</a>
  </Section>

  <Section eyebrow="Kind words" title="What clients say."><Testimonials /></Section>

  <Section eyebrow="FAQs" title="Straight answers."><Faq /></Section>

  <CtaBand />
</Base>
