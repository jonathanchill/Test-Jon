---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import CtaBand from '@/components/CtaBand.astro';
import { site } from '@/data/site';
const team = [
  ['Founder name', 'Founder & CEO'], ['Name', 'Technical Director'], ['Name', 'Head of AI'], ['Name', 'Creative Director'], ['Name', 'Head of Product'], ['Name', 'Lead Engineer'],
];
const values = [
  ['Say the true thing', 'To clients and to each other, early, even when it is awkward.'],
  ['Ship, then learn', 'Working software beats a perfect plan. Short loops, honest measurement.'],
  ['Own the outcome', 'We are paid for results, not hours. We act like it.'],
  ['Leave it better', 'Code, documentation, people. Every handover should be easier than the last.'],
];
---
<Base title="Team" description={`Meet the people behind ${site.name}: senior strategists, designers and engineers who build AI and digital products.`}>
  <Hero eyebrow="Our team" title="Senior people. <span class='text-signal'>Small teams.</span>" lede="The people you meet in the first call are the people who do the work. No bait-and-switch to a junior bench." />
  <Section eyebrow="People" title="Meet the team">
    <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {team.map(([n, r], i) => <li><div class="aspect-square rounded-3xl border border-line" style={`background: linear-gradient(160deg, hsl(${(i * 53) % 360} 50% 90%), hsl(${(i * 53 + 60) % 360} 45% 80%));`} role="img" aria-label="Team photo placeholder"></div><p class="mt-4 text-lg font-semibold">{n}</p><p class="text-muted">{r}</p></li>)}
    </ul>
  </Section>
  <Section dark eyebrow="How we behave" title="Four values we hire and fire by.">
    <div class="grid gap-6 md:grid-cols-2">{values.map(([h, p]) => <div class="rounded-3xl border border-paper/15 p-7"><h3 class="text-xl font-bold">{h}</h3><p class="mt-3 text-paper/70">{p}</p></div>)}</div>
  </Section>
  <CtaBand title="Want to join us?" body="We are always interested in senior engineers, designers and AI specialists who like shipping." label="See careers" href="/careers" />
</Base>
