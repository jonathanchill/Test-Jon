---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import CtaBand from '@/components/CtaBand.astro';
import WorkCard from '@/components/WorkCard.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { locations } from '@/data/locations';
import { services } from '@/data/services';
import { site } from '@/data/site';
import { getCollection } from 'astro:content';
export async function getStaticPaths() { return locations.map((l) => ({ params: { slug: l.slug }, props: { loc: l } })); }
const { loc } = Astro.props;
const addr = site.addresses[0];
const allWork = await getCollection('work');
const nearby = (loc.clients ?? []).map((c) => allWork.find((w) => w.data.client.toLowerCase() === c.toLowerCase())).filter(Boolean) as typeof allWork;
const others = locations.filter((l) => l.slug !== loc.slug).slice(0, 6);
const growth = services.filter((s) => ['ai-search-visibility', 'marketing-websites', 'process-automation', 'ten-day-ai-sprint', 'ai-opportunity-audit', 'web-platforms'].includes(s.slug));
const title = `AI & digital agency for ${loc.name}`;
const description = `Guildford AI and digital agency serving ${loc.name}, ${loc.county}. AI automation, AI search visibility and websites that win customers, ${loc.minutes} minutes from our studio.`;
const ld = [
  { '@context': 'https://schema.org', '@type': 'Service', name: `AI and digital services in ${loc.name}`, provider: { '@type': 'ProfessionalService', name: site.name, address: { '@type': 'PostalAddress', streetAddress: addr.lines[0], addressLocality: 'Guildford', addressRegion: 'Surrey', postalCode: addr.lines[3], addressCountry: 'GB' } }, areaServed: { '@type': 'City', name: loc.name }, description },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() }, { '@type': 'ListItem', position: 2, name: 'Areas we serve', item: new URL('/locations', Astro.site).toString() }, { '@type': 'ListItem', position: 3, name: loc.name, item: new URL(`/locations/${loc.slug}`, Astro.site).toString() }] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: loc.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={title} description={description} jsonLd={ld}>
  <section class="relative overflow-hidden grain">
    <div class="blobs" aria-hidden="true"><div class="blob blob-a"></div><div class="blob blob-b"></div><div class="blob blob-c"></div></div>
    <div class="container-x relative py-20 lg:py-28">
      <nav aria-label="Breadcrumb" class="rise eyebrow"><a href="/locations" class="hover:text-signal">Areas we serve</a> · {loc.county}</nav>
      <h1 class="rise rise-2 mt-4 max-w-5xl text-display-xl font-bold leading-[0.95]">AI & digital agency for <span class="text-signal">{loc.name}</span> businesses.</h1>
      <p class="rise rise-3 mt-8 max-w-2xl text-xl leading-relaxed text-ink/75">We are based in Guildford, {loc.miles} miles and about {loc.minutes} minutes from {loc.name}. We have clients across {loc.county} and work in {loc.name} regularly: in your office for workshops and reviews, and from our studio for the build.</p>
      <div class="rise rise-3 mt-10 flex flex-wrap gap-3"><a href="/contact" class="btn-primary shine">Book a 30-minute call</a><a href="/ai-readiness" class="btn-outline">Take the AI readiness scorecard</a></div>
    </div>
  </section>

  <Section>
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="prose-basic lg:col-span-7" data-reveal>
        <h2 class="!mt-0">Working with {loc.name} businesses</h2>
        <p>{loc.intro}</p>
        <h3>The local economy as we see it</h3>
        <p>{loc.economy}</p>
        <h3>Where AI tends to pay back first in {loc.name}</h3>
        <ul>
          <li><strong>Bringing the right customers to you.</strong> Websites built to rank, and AI search visibility so ChatGPT, Gemini and Perplexity recommend you when people in {loc.name} and beyond ask who to use.</li>
          <li><strong>Quoting, enquiries and documents.</strong> The admin that sits between a lead and a sale, automated with a person approving every step.</li>
          <li><strong>Reporting and knowledge.</strong> One place for the information your team keeps re-finding, and reports that write their first draft themselves.</li>
        </ul>
      </div>
      <aside class="lg:col-span-5" data-reveal>
        <div class="sticky top-28 rounded-3xl bg-ink p-8 text-paper">
          <p class="eyebrow text-paper/50">Our studio</p>
          <p class="mt-3 text-xl font-semibold">{addr.lines.join(', ')}</p>
          <dl class="mt-6 grid grid-cols-2 gap-4 text-sm">
            <div><dt class="text-paper/60">Distance to {loc.name}</dt><dd class="text-lg font-semibold">{loc.miles} miles</dd></div>
            <div><dt class="text-paper/60">Typical drive</dt><dd class="text-lg font-semibold">{loc.minutes} minutes</dd></div>
          </dl>
          <p class="mt-6 text-sm text-paper/70">Sectors we meet most in {loc.name}:</p>
          <ul class="mt-2 flex flex-wrap gap-2">{loc.sectors.map((s) => <li class="rounded-full border border-paper/20 px-3 py-1 text-xs">{s}</li>)}</ul>
          <a href={addr.mapsUrl} rel="noopener" class="btn-light mt-8 w-full justify-center">Directions to the studio</a>
        </div>
      </aside>
    </div>
  </Section>

  {nearby.length > 0 && (
    <Section eyebrow="Nearby work" title={`Clients in and around ${loc.name}.`} class="bg-paper-deep">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3" data-reveal="stagger">{nearby.map((w) => <WorkCard entry={w} />)}</div>
    </Section>
  )}

  <Section eyebrow="Services" title={`What we do for businesses in ${loc.name}.`} lede="Everything below is delivered from Guildford with in-person time in your town. Fixed prices on audits and sprints, published rate bands on everything else.">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal="stagger">{growth.map((s) => <ServiceCard service={s} />)}</div>
  </Section>

  <Section eyebrow="FAQs" title={`Questions from ${loc.name} businesses.`}>
    <div class="divide-y divide-line border-y border-line">
      {loc.faq.map((f) => (<details class="group py-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold [&::-webkit-details-marker]:hidden">{f.q}<span class="shrink-0 text-2xl leading-none transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary><p class="mt-3 max-w-3xl text-ink/70">{f.a}</p></details>))}
      <details class="group py-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold [&::-webkit-details-marker]:hidden">Are you actually based in {loc.name}?<span class="shrink-0 text-2xl leading-none transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary><p class="mt-3 max-w-3xl text-ink/70">No, and we would rather say so. Our studio is in Guildford at {addr.lines[0]}. We work with clients in {loc.name} and travel there for the parts of a project that are better done face to face.</p></details>
    </div>
  </Section>

  <Section eyebrow="Also nearby" title="Other areas we serve." class="bg-paper-deep">
    <ul class="flex flex-wrap gap-3">{others.map((l) => <li><a href={`/locations/${l.slug}`} class="rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold hover:border-ink">{l.name}</a></li>)}<li><a href="/locations" class="rounded-full bg-ink px-4 py-2 text-sm font-semibold text-paper">All areas</a></li></ul>
  </Section>

  <CtaBand title={`Talk to us about AI and digital in ${loc.name}`} body="A 30-minute call, or a coffee in your town. Bring a problem and we will tell you honestly whether AI, software or neither is the answer." />
</Base>
