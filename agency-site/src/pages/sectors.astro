---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import CtaBand from '@/components/CtaBand.astro';
import { sectors } from '@/data/sectors';
---
<Base title="AI & Digital Services by Industry Sector" description="AI and digital expertise shaped around your industry: financial services, healthcare, retail, media, professional services, property, charities and startups.">
  <Hero eyebrow="Sectors" title="Every sector has its own pressures. <span class='text-signal'>We have done the homework.</span>" lede="The same engineering rigour, shaped around the regulation, data and customers your industry actually has." cta={{ label: 'Arrange a discovery call', href: '/contact' }} />
  <Section>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {sectors.map((s) => <div class="card"><h2 class="text-xl font-semibold">{s.name}</h2><p class="mt-3 text-ink/70">{s.blurb}</p></div>)}
    </div>
  </Section>
  <CtaBand />
</Base>
