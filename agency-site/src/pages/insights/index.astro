---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import CtaBand from '@/components/CtaBand.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('insights')).filter((p) => !p.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="Insights" description="Plain-spoken writing on AI strategy, engineering, adoption and digital products.">
  <Hero eyebrow="Insights" title="Thinking out loud, <span class='text-signal'>in plain English.</span>" lede="What we are learning from shipping AI and digital products. No listicles, no hype." />
  <section class="container-x pb-20">
    <ul class="divide-y divide-line border-y border-line">
      {posts.map((p) => (
        <li><a href={`/insights/${p.id}`} class="group grid gap-3 py-8 md:grid-cols-12 md:items-baseline">
          <p class="font-mono text-sm text-muted md:col-span-3">{fmt(p.data.date)} · {p.data.readingTime} min read</p>
          <div class="md:col-span-9"><h2 class="text-2xl font-semibold group-hover:text-signal">{p.data.title}</h2><p class="mt-2 text-ink/70">{p.data.description}</p></div>
        </a></li>
      ))}
    </ul>
  </section>
  <CtaBand />
</Base>
